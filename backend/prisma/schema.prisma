// Schema do banco de dados da Associação Asafe
// Banco: PostgreSQL (hospedado no Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum StudentStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum MusicLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditEntity {
  STUDENT
  TEACHER
  ADMIN_USER
  INSTRUMENT
  PROJECT
  CLASS_GROUP
  CLASS_TEACHER
  ENROLLMENT
  ATTENDANCE_SESSION
}

enum InstrumentStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  CLOSED
  ARCHIVED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassGroupStatus {
  ACTIVE
  CLOSED
  SUSPENDED
}

enum ClassTeacherRole {
  RESPONSIBLE
  ASSISTANT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
  LATE
}

// ------------------------------------------------------
// Usuários administrativos
// ------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]

  attendanceSessionsCreated AttendanceSession[] @relation("AttendanceSessionCreatedBy")
  attendanceSessionsUpdated AttendanceSession[] @relation("AttendanceSessionUpdatedBy")

  @@index([email])
  @@map("admin_users")
}

// ------------------------------------------------------
// Instrumentos / cursos
// ------------------------------------------------------

model Instrument {
  id           String           @id @default(cuid())
  name         String           @unique
  description  String?
  status       InstrumentStatus @default(ACTIVE)
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  students    Student[]
  teachers    TeacherInstrument[]
  projects    ProjectInstrument[]
  classGroups ClassGroup[]

  @@index([name])
  @@index([status])
  @@map("instruments")
}

// ------------------------------------------------------
// Professores
// ------------------------------------------------------

model Teacher {
  id            String        @id @default(cuid())
  fullName      String
  socialName    String?
  document      String?       @unique
  phone         String?
  whatsapp      String?
  email         String?       @unique
  address       String?
  specialty     String?
  hireDate      DateTime?
  status        TeacherStatus @default(ACTIVE)
  photoUrl      String?
  photoPublicId String?
  bio           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students    Student[]
  instruments TeacherInstrument[]
  classGroups ClassTeacher[]

  @@index([fullName])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("teachers")
}

// Tabela associativa explícita entre professor e instrumento (N:N)
model TeacherInstrument {
  teacherId    String
  instrumentId String

  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([teacherId, instrumentId])
  @@map("teacher_instruments")
}

// ------------------------------------------------------
// Alunos
// ------------------------------------------------------

model Student {
  id             String        @id @default(cuid())
  fullName       String
  socialName     String?
  birthDate      DateTime?
  document       String?       @unique
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  state          String?
  level          MusicLevel    @default(BEGINNER)
  enrollmentDate DateTime?
  status         StudentStatus @default(ACTIVE)
  photoUrl       String?
  photoPublicId  String?
  notes          String?

  instrumentId String?
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@index([fullName])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([teacherId])
  @@index([deletedAt])
  @@map("students")
}

// ------------------------------------------------------
// Projetos
// ------------------------------------------------------

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String?
  objective     String?
  location      String?
  responsible   String?
  notes         String?
  imageUrl      String?
  imagePublicId String?
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  endDate       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  instruments ProjectInstrument[]
  classGroups ClassGroup[]

  @@index([name])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

// Tabela associativa entre projeto e instrumento (N:N)
model ProjectInstrument {
  projectId    String
  instrumentId String
  createdAt    DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@id([projectId, instrumentId])
  @@map("project_instruments")
}

// ------------------------------------------------------
// Turmas
// ------------------------------------------------------

model ClassGroup {
  id           String           @id @default(cuid())
  name         String
  projectId    String
  instrumentId String
  weekday      Weekday
  startTime    String
  endTime      String?
  room         String?
  capacity     Int?
  status       ClassGroupStatus @default(ACTIVE)
  notes        String?
  startDate    DateTime?
  endDate      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  teachers           ClassTeacher[]
  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]

  @@index([projectId])
  @@index([instrumentId])
  @@index([status])
  @@index([deletedAt])
  @@map("class_groups")
}

// Tabela associativa entre turma e professor (responsável ou auxiliar)
model ClassTeacher {
  classGroupId String
  teacherId    String
  role         ClassTeacherRole
  createdAt    DateTime         @default(now())

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@id([classGroupId, teacherId])
  @@index([teacherId])
  @@map("class_teachers")
}

// Matrícula de aluno em turma (remoção é lógica, preserva histórico de chamadas)
model Enrollment {
  id           String    @id @default(cuid())
  classGroupId String
  studentId    String
  enrolledAt   DateTime  @default(now())
  removedAt    DateTime?

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([classGroupId, studentId])
  @@index([classGroupId])
  @@index([studentId])
  @@map("enrollments")
}

// ------------------------------------------------------
// Chamadas / frequência
// ------------------------------------------------------

model AttendanceSession {
  id           String   @id @default(cuid())
  classGroupId String
  date         DateTime @db.Date
  generalNotes String?
  createdById  String?
  updatedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classGroup ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  createdBy  AdminUser?         @relation("AttendanceSessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  AdminUser?         @relation("AttendanceSessionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  records    AttendanceRecord[]

  @@unique([classGroupId, date])
  @@index([classGroupId])
  @@index([date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@map("attendance_records")
}

// ------------------------------------------------------
// Log de auditoria (criação/edição/exclusão)
// ------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  entityType AuditEntity
  entityId   String
  action     AuditAction
  changes    Json?
  createdAt  DateTime    @default(now())

  userId String?
  user   AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
