# ============================================
# Associação Asafe - Backend - Variáveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" com valores reais no git.
# ============================================

# Porta em que a API vai rodar
PORT=4000

# Ambiente: development | production | test
NODE_ENV=development

# URL de conexão do PostgreSQL (Railway fornece esta variável automaticamente
# quando você provisiona um banco Postgres no seu projeto Railway)
DATABASE_URL="postgresql://usuario:senha@host:5432/asafe?schema=public"

# Segredo usado para assinar os tokens JWT (gere uma string aleatória longa,
# por exemplo com: openssl rand -base64 48)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Tempo de expiração do token JWT
JWT_EXPIRES_IN="7d"

# Nome do cookie httpOnly usado para armazenar o token de sessão
AUTH_COOKIE_NAME="asafe_session"

# Domínio(s) permitido(s) para CORS, separados por vírgula
# Ex: http://localhost:5173,https://asafe-admin.vercel.app
CORS_ORIGIN="http://localhost:5173"

# Dados do administrador criado pelo script de seed (rode "npm run seed")
ADMIN_NAME="Administrador Asafe"
ADMIN_EMAIL="admin@asafe.org"
ADMIN_PASSWORD="TrocarEssaSenha123!"

# Credenciais do Cloudinary (painel do Cloudinary > Dashboard > Product Environment)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Pasta usada dentro do Cloudinary para organizar os uploads do sistema
CLOUDINARY_FOLDER="asafe"

# Tamanho máximo de upload de imagem, em bytes (padrão: 5MB)
MAX_UPLOAD_SIZE_BYTES=5242880
